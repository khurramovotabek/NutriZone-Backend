# Copy this file to .env.local for local development. Never commit a
# populated .env file (Django Implementation Blueprint §7). In staging/
# production, these are injected by the platform's secrets manager, not
# read from a file at all.

DJANGO_ENV=development
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=nutrizone
POSTGRES_USER=nutrizone
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CHANNELS_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Payment webhook (Phase 02E's internal, provider-agnostic contract) ---
# Falls back to SECRET_KEY if unset (see config/settings/components/payment_webhook.py) --
# set this explicitly and separately in production so the two secrets can be rotated independently.
PAYMENT_WEBHOOK_SECRET=

# --- HTTPS (production only) ---
# Only set to true once docker/nginx/nginx.https.conf.template is
# actually active (real domain + real TLS certificate obtained, see
# that file's own 6-step activation procedure). Until then, leave
# unset/false -- the currently-active nginx.conf is HTTP-only, and
# setting this before that switch-over would redirect all traffic to
# a port nginx doesn't listen on.
NUTRIZONE_HTTPS_READY=false

# --- Storage ---
NUTRIZONE_STORAGE_BACKEND=local
NUTRIZONE_OBJECT_STORAGE_BUCKET=
NUTRIZONE_OBJECT_STORAGE_ENDPOINT=

# --- External Providers (Phase 04) ---
# OTP/SMS: "console" (default, logs the code, sends nothing real) or "eskiz".
NUTRIZONE_OTP_PROVIDER=console
# Optional: raises the real 3/hour-per-phone OTP request quota (see
# apps.identity.domain.services.OTPPolicy). Leave unset in production --
# only set this in local/dev environments to avoid hitting the same
# real limit a customer would while repeatedly testing the login flow.
OTP_MAX_REQUESTS_PER_HOUR=3
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER_NAME=4546
ESKIZ_API_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_TIMEOUT_SECONDS=10

# Telegram notifications: "disabled" (default, fails loudly rather than
# silently no-op'ing) or "live". Set to "live" for Telegram login (auto-login
# and 6-digit code) to actually send messages -- otherwise every send
# raises NotImplementedError and the bot appears completely broken.
NUTRIZONE_TELEGRAM_GATEWAY=disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_ORDERS_CHAT_ID=

# Required for the webhook to accept real updates from Telegram (rejects
# every request without this configured -- see telegram_bot.checks W001).
TELEGRAM_WEBHOOK_SECRET=

# NutriZoneAnalyticsBot (management reports + unanswered-chat alerts). Recipients
# are an explicit allowlist of chat ids (people or groups, comma-separated) --
# write /start to the bot to learn your id. Then: manage.py analytics_bot_setup
TELEGRAM_ANALYTICS_BOT_TOKEN=
TELEGRAM_ANALYTICS_BOT_USERNAME=NutriZoneAnalyticsBot
TELEGRAM_ANALYTICS_WEBHOOK_SECRET=
TELEGRAM_ANALYTICS_CHAT_IDS=

# Automatically registers the webhook URL with Telegram on server startup.
# Requires TELEGRAM_BOT_TOKEN and PUBLIC_BASE_URL below to both be set --
# silently skipped otherwise. Off by default so no CI/sandbox/local-dev run
# ever makes an unexpected outbound network call.
TELEGRAM_AUTO_SET_WEBHOOK=false

# Only needed if you run the optional `cloudflared-named` Docker Compose
# service (a stable-domain Cloudflare Tunnel -- see docker-compose.yml's own
# comment on that service for the one-time `cloudflared tunnel create` setup).
# Leave blank if you're not using a Named Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Must be a real, public, HTTPS-reachable URL -- Telegram's own servers call
# this address directly, so a bare "http://localhost:8000" will never work
# for Telegram. Also used to build full, absolute product/category image
# URLs (see apps/products/infrastructure/selectors.py's _resolve_media_url) --
# left blank, image URLs become bare relative paths a frontend resolves
# against its own (wrong) origin, so every image request 404's there.
# For local Docker development, use a tunnel (e.g. ngrok, cloudflared) and
# put its public HTTPS URL here for Telegram; for local, non-Telegram image
# testing only, "http://localhost:8000" is acceptable. For production, your
# real domain.
PUBLIC_BASE_URL=

# The customer-facing Next.js storefront's own public origin (e.g.
# "https://nutrizone.uz" in production, "http://localhost:3000" for
# local dev), distinct from PUBLIC_BASE_URL above (the backend API's
# own origin). Used to build the Telegram bot's "auto-login" deep
# link -- left blank, that flow cannot construct a valid link back to
# the storefront.
FRONTEND_URL=

# Temporarily disabled per explicit product decision -- Telegram is
# now the sole customer-facing login path (phone+SMS/OTP login is
# kept as a simple, reversible toggle, not deleted). Does NOT affect
# /auth/verify-otp (shared with the Telegram 6-digit-code flow) or
# any Telegram-specific endpoint.
NUTRIZONE_SMS_LOGIN_ENABLED=false

# --- Logging ---
DJANGO_LOG_LEVEL=INFO
JSON_LOGS=false
LOG_DIR=logs

# --- Feature toggles (infrastructure-level only, per Django
#     Implementation Blueprint §7 -- business flags live in the
#     `platform` app's feature_flags table, not here) ---
ENABLE_CHANNELS=true

# --- Production monitoring & ops ---
# Error reporting (sentry-sdk ships in requirements/production.txt; nothing is sent while empty).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Fraction of requests traced for performance (0 = errors only, e.g. 0.1 = 10%).
SENTRY_TRACES_SAMPLE_RATE=0
# The OpenAPI schema / Swagger / ReDoc are private in production unless this is true.
API_DOCS_ENABLED=false
# db_backup service (docker-compose.prod.yml): days of daily pg_dump files to keep.
BACKUP_KEEP_DAYS=14

# ---- AI shopping assistant (apps/assistant, Claude API) -- off until ANTHROPIC_API_KEY is set
ANTHROPIC_API_KEY=
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
ASSISTANT_MAX_TURNS=30
ASSISTANT_RATE_PER_10_MIN=20
ASSISTANT_RATE_PER_DAY=150
# Read-aloud with natural voices (Uzbek uz-UZ-MadinaNeural / SardorNeural, Russian, English): Azure Speech resource key + region
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ASSISTANT_TTS_VOICE_UZ=
