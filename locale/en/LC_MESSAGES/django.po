#, python-format
msgid "%(order)s savdosi bekor qilindi."
msgstr "Sale %(order)s was cancelled."

#, python-format
msgid "%(order)s savdosi qaytarildi, mahsulotlar omborga qaytarildi."
msgstr "Sale %(order)s was refunded; the products were returned to stock."

msgid "Aniq moslik"
msgstr "Exact match"

